{
	"name": "ddns",
	"version": "0.0.7",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"apigen": "openapi-zod-client ../../crates/dyndns/generated/openapi.json -o ./src/generated/zodiosClient.ts --default-status auto-correct",
		"build": "vite build",
		"watch": "vite build -w",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint_fix": "eslint --fix .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@fortawesome/fontawesome-free": "7.3.1",
		"@sveltejs/adapter-auto": "8.0.0",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tanstack/svelte-query": "6.3.5",
		"@tanstack/svelte-query-devtools": "6.3.5",
		"bulma": "1.0.4",
		"dayjs": "1.11.23",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"openapi-zod-client": "1.18.3",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"rxjs": "7.8.2",
		"sass": "1.106.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vite": "8.3.5"
	},
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	}
}
